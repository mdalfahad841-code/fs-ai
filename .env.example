# FS AI — environment template
# PLACEHOLDERS ONLY. Copy to .env and fill in real values locally.
# NEVER commit a real .env, token, secret or ID to the repo.
# Real values live only in the Cloudflare dashboard / GitHub Secrets.

# Cloudflare account (find in the Cloudflare dashboard URL / account home)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare D1 database (returned by `wrangler d1 create fs-ai-db`)
D1_DATABASE_ID=your-d1-database-id
D1_DATABASE_NAME=fs-ai-db

# Cloudflare API token (deploy only; scope: Workers + D1 + Pages, account level)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Session secret for owner login sessions (generate a long random string)
SESSION_SECRET=your-long-random-session-secret

# Owner account (login email for the FS AI admin)
OWNER_EMAIL=owner@example.com

# Public site URL once deployed (Cloudflare Pages assigns *.pages.dev)
PUBLIC_SITE_URL=https://fs-ai.pages.dev

# Optional: deployment smoke-test target for tests/api-smoke.test.js
# Leave empty to skip live checks honestly.
FS_AI_URL=
